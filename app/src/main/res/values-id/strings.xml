    <!-- Architecture Dialog -->
    <string name="arch_dialog_title">Arsitektur Telefoni Android</string>
    <string name="arch_dialog_intro">DialFlow mengikuti aturan telefoni native Android tanpa jalan pintas yang meragukan:</string>
    <string name="arch_dialog_standard_mode">1. Mode Aplikasi Standar:\n• Memulai panggilan seluler keluar menggunakan ACTION_CALL (memerlukan CALL_PHONE).\n• TelephonyCallback/TelephonyManager mendeteksi panggilan terputus (transisi OFFHOOK → IDLE).\n• Android membatasi aplikasi standar membaca status panggilan terperinci tanpa status dialer utama.</string>
    <string name="arch_dialog_default_mode">2. Mode Dialer Utama (ROLE_DIALER):\n• Membuka Telecom InCallService.\n• InCallService menerima status panggilan langsung secara akurat (DIALING, RINGING, ACTIVE, DISCONNECTED) untuk panggilan berurutan otomatis.</string>
    <string name="arch_status_active">Status: Dialer Utama Aktif (InCallService Diaktifkan)</string>
    <string name="arch_status_standard">Status: Beroperasi dalam Mode Standar</string>
